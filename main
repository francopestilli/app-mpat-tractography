#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# Generated by faber's scaffold_brainlife_app.py -- this is the entrypoint
# brainlife.io's orchestrator invokes directly (`./main`). It stages
# config.json into the working directory before running this.

set -e

mkdir -p tractmeasures

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

singularity exec -e docker://gamorosino/mpat-tractography:1.0 python3 run_mpat.py

[ -z "$(ls -A tractmeasures)" ] && echo "no output produced in tractmeasures/" && exit 1
exit 0
